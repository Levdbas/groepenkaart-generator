{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Levdbas/groepenkaart-generator/main/schemas/groepenkaart-v2.schema.json",
  "title": "JSON schema for groepenkaart v2",
  "description": "Group rcboId values must refer to the id of an entry in rcbos. When rcboEnabled is false, rcbos must be empty.",
  "type": "object",
  "required": ["schemaVersion", "warnings", "rcboEnabled", "rcbos", "boxes"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "URL of the JSON Schema used to validate this file."
    },
    "schemaVersion": {
      "description": "Version of the groepenkaart data format.",
      "type": "integer",
      "const": 2
    },
    "warnings": {
      "type": "array",
      "items": { "enum": ["pv", "ev", "battery", "heat-pump"] }
    },
    "rcboEnabled": {
      "description": "Whether groups can be linked to RCBOs (Aardlekschakelaars).",
      "type": "boolean"
    },
    "rcbos": {
      "type": "array",
      "items": { "$ref": "#/$defs/rcbo" }
    },
    "boxes": {
      "type": "array",
      "items": { "$ref": "#/$defs/box" }
    }
  },
  "if": { "properties": { "rcboEnabled": { "const": false } } },
  "then": { "properties": { "rcbos": { "maxItems": 0 } } },
  "$defs": {
    "rcbo": {
      "type": "object",
      "required": ["id", "number", "name", "color"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "number": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "box": {
      "type": "object",
      "required": ["number", "name", "groups"],
      "properties": {
        "number": { "type": "string" },
        "name": { "type": "string" },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/group" }
        }
      }
    },
    "group": {
      "type": "object",
      "required": ["number", "name", "description", "rcboId"],
      "properties": {
        "number": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "items": {
          "description": "Optional list of appliances or connections on this group.",
          "type": "array",
          "items": { "type": "string" }
        },
        "rcboId": { "type": ["string", "null"] }
      }
    }
  }
}
