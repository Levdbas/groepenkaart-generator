{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Levdbas/groepenkaart-generator/main/schemas/groepenkaart-v5.schema.json",
  "title": "JSON schema for groepenkaart v5",
  "description": "Modules are stored once in the modules list and boxes refer to their ordered module IDs. Protection and sub-distribution supply references target module IDs. A null boxId preserves modules with unknown physical location.",
  "type": "object",
  "required": [
    "schemaVersion",
    "qrEnabled",
    "rcdEnabled",
    "phaseEnabled",
    "modules",
    "boxes"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "type": "integer", "const": 5 },
    "qrEnabled": { "type": "boolean" },
    "rcdEnabled": { "type": "boolean" },
    "phaseEnabled": { "type": "boolean" },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    },
    "boxes": {
      "type": "array",
      "items": { "$ref": "#/$defs/box" }
    }
  },
  "if": { "properties": { "rcdEnabled": { "const": false } } },
  "then": {
    "properties": {
      "modules": {
        "items": {
          "not": {
            "properties": {
              "type": { "enum": ["RCD-2P", "RCD-4P", "RCBO-2P", "RCBO-4P"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "phases": {
      "type": "array",
      "items": { "enum": ["L1", "L2", "L3"] },
      "uniqueItems": true,
      "maxItems": 3
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "boxId",
        "type",
        "number",
        "description",
        "characteristic",
        "phases",
        "protectedByModuleId"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "boxId": { "type": ["string", "null"] },
        "type": {
          "enum": [
            "MCB",
            "MCB-2P",
            "MCB-3P",
            "RCD-2P",
            "RCD-4P",
            "MAINS-2P",
            "MAINS-4P",
            "RCBO-2P",
            "RCBO-4P",
            "DIN-OUTLET",
            "Bell-TRANSFORMER",
            "KWH-2P",
            "KWH-4P",
            "SPD"
          ]
        },
        "number": { "type": "string" },
        "description": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "characteristic": { "type": "string" },
        "phases": { "$ref": "#/$defs/phases" },
        "protectedByModuleId": { "type": ["string", "null"] },
        "items": { "type": "array", "items": { "type": "string" } },
        "sensitivity": { "type": "integer", "enum": [10, 30, 100, 300] },
        "rcdType": { "enum": ["AC", "A", "F", "B", "B+"] },
        "ratedCurrent": { "type": "number", "exclusiveMinimum": 0 },
        "warning": {
          "description": "Installation this module flags with a warning card on the first page. Only MCB and MCB-2P modules may set it.",
          "enum": ["pv", "ev", "battery"]
        }
      },
      "if": {
        "properties": {
          "type": { "enum": ["RCD-2P", "RCD-4P", "RCBO-2P", "RCBO-4P"] }
        }
      },
      "then": { "required": ["color"] },
      "allOf": [
        {
          "if": { "required": ["warning"] },
          "then": { "properties": { "type": { "enum": ["MCB", "MCB-2P"] } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["RCD-4P", "RCBO-4P"] } } },
          "then": { "properties": { "phases": { "minItems": 3 } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["RCD-2P", "RCBO-2P"] } } },
          "then": { "properties": { "phases": { "maxItems": 1 } } }
        }
      ]
    },
    "box": {
      "type": "object",
      "required": ["id", "number", "name", "moduleIds", "supply"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "number": { "type": "string" },
        "name": { "type": "string" },
        "moduleIds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "supply": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/mainsSupply" },
            { "$ref": "#/$defs/subdistributionSupply" }
          ]
        }
      }
    },
    "mainsSupply": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "mains" },
        "connectionRating": {
          "enum": [
            "1x25A",
            "1x35A",
            "1x40A",
            "3x25A",
            "3x35A",
            "3x40A",
            "3x50A",
            "3x63A",
            "3x80A",
            "Anders"
          ]
        },
        "customConnectionRating": { "type": "string" },
        "supplier": { "type": "string" },
        "mainSwitchCurrent": { "type": "number", "exclusiveMinimum": 0 },
        "mainSwitchPoles": { "type": "integer", "enum": [2, 4] }
      }
    },
    "subdistributionSupply": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "subdistribution" },
        "sourceModuleId": { "type": ["string", "null"] },
        "preFuse": { "type": "string" },
        "cableCores": { "type": "integer", "minimum": 1 },
        "cableCrossSection": { "type": "number", "exclusiveMinimum": 0 },
        "mainSwitchCurrent": { "type": "number", "exclusiveMinimum": 0 },
        "mainSwitchPoles": { "type": "integer", "enum": [2, 4] }
      }
    }
  }
}
