{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Levdbas/groepenkaart-generator/main/schemas/groepenkaart-v1.schema.json",
  "title": "JSON schema for groepenkaart v1",
  "type": "object",
  "required": ["schemaVersion", "warnings", "boxes"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "URL of the JSON Schema used to validate this file."
    },
    "schemaVersion": {
      "description": "Version of the groepenkaart data format.",
      "type": "integer",
      "const": 1
    },
    "warnings": {
      "type": "array",
      "items": { "enum": ["pv", "ev", "battery", "heat-pump"] }
    },
    "boxes": {
      "type": "array",
      "items": { "$ref": "#/$defs/box" }
    }
  },
  "$defs": {
    "box": {
      "type": "object",
      "required": ["number", "name", "groups"],
      "properties": {
        "number": { "type": "string" },
        "name": { "type": "string" },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/group" }
        }
      }
    },
    "group": {
      "type": "object",
      "required": ["number", "name", "description"],
      "properties": {
        "number": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
