{
  "name": "groepenkaart-generator",
  "version": "2.0.1",
  "description": "Maak je eigen groepenkaart voor de meterkast en download deze als PDF.",
  "private": true,
  "type": "module",
  "homepage": "https://levdbas.github.io/groepenkaart-generator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Levdbas/groepenkaart-generator.git"
  },
  "bugs": {
    "url": "https://github.com/Levdbas/groepenkaart-generator/issues"
  },
  "keywords": [
    "groepenkaart",
    "groepenindeling",
    "meterkast",
    "pdf"
  ],
  "author": "Levdbas",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node --watch-path=src --watch-path=public scripts/build.mjs --serve",
    "test": "node --test"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "pdfjs-dist": "^6.4.299",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
